datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Código fácil de partilhar (nome de fruta), ex.: "morango"
  code String? @unique

  // Configuração de jogo
  players    Int    @default(1) // nº de jogadoras humanas (1 a 3)
  humanRoles String @default("[]") // JSON array dos papéis humanos; os restantes são CPU

  patients Patient[]
  stats    Stats?

  @@index([createdAt])
}

model Patient {
  id        String  @id @default(cuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  // Info básica
  name    String
  age     Int
  symptoms String // JSON stringified array
  story    String? // pequena história divertida de quando começaram os sintomas
  urgency String @default("normal") // "normal" | "urgent"

  // Workflow status: triage | diagnosis | treatment | discharge | discharged
  status String @default("triage")

  // Quem está a atender (multiplayer)
  assignedTo String?

  // Triagem
  triageColor String? // verde | amarela | laranja | vermelha
  health      Int? // 0-100 (estado do doente; sobe com o tratamento)

  // Dados clínicos
  temp      Float?
  hr        Int?
  bp        String?
  diagnosis String?
  medicine  String? // JSON: [{ name, emoji, type, total, given, lastGivenAt }]
  exams     String? // JSON: [{ name, emoji, result }] (pedidos pelo médico, feitos pelo TAD)
  notes     String?
  rating    Int? // 1-5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
  @@index([status])
  @@index([urgency])
}

model Stats {
  id        String  @id @default(cuid())
  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  totalTreated Int   @default(0)
  avgWaitTime  Float @default(0)
  satisfaction Float @default(0)

  @@index([sessionId])
}
