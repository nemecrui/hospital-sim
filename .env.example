# Backend (Fastify + Prisma)
# Local: podes usar SQLite para arrancar depressa OU um Postgres local.
# Railway injeta automaticamente DATABASE_URL (Postgres).
DATABASE_URL="postgresql://user:password@localhost:5432/hospitalsim?schema=public"

# URL do frontend (para o CORS em produção)
FRONTEND_URL="http://localhost:5173"

NODE_ENV="development"
PORT="3000"
