{
  "name": "hospital-sim-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hospital Simulador — backend (Fastify + Prisma) que também serve o frontend",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:api": "node src/server.js",
    "build": "npm --prefix web install --include=dev && npm --prefix web run build",
    "prisma:generate": "prisma generate --schema=src/db/schema.prisma",
    "prisma:push": "prisma db push --schema=src/db/schema.prisma --accept-data-loss",
    "prisma:studio": "prisma studio --schema=src/db/schema.prisma",
    "seed": "node src/db/seed.js",
    "postinstall": "prisma generate --schema=src/db/schema.prisma"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.1.0",
    "prisma": "^5.22.0"
  }
}
